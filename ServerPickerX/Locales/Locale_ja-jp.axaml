  <x:String x:Key="SortLoss">ロス</x:String>
  <x:String x:Key="StatusBlocked">ブロック中</x:String>
  <x:String x:Key="PingServerMenuItem">このサーバーを測定</x:String>
  <x:String x:Key="NoServersMatch">一致するサーバーがありません</x:String>
  <x:String x:Key="BlockAllToolTip">表示中のサーバーをすべてブロック</x:String>
