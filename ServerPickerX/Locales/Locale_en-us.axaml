<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:String x:Key="LanguageCode">en-us</x:String>
  <x:String x:Key="ClusterServers">Cluster Servers</x:String>
  <x:String x:Key="UnclusterServers">Uncluster Servers</x:String>
  <x:String x:Key="Refresh">Refresh</x:String>
  <x:String x:Key="SearchForServers">Search for servers...</x:String>
  <x:String x:Key="NoPresets">No presets</x:String>
  <x:String x:Key="BlockAll">Block All</x:String>
  <x:String x:Key="BlockSelected">Block Selected</x:String>
  <x:String x:Key="UnblockAll">Unblock All</x:String>
  <x:String x:Key="UnblockSelected">Unblock Selected</x:String>
  <x:String x:Key="SaveButtonText">Save</x:String>
  <x:String x:Key="CancelButtonText">Cancel</x:String>
  <x:String x:Key="CheckForNewVersion">Check for new version on startup</x:String>
  <x:String x:Key="ResetFirewall">Remove App Rules</x:String>
  <x:String x:Key="GameModeToolTip">Select game mode</x:String>
  <x:String x:Key="PresetToolTip">Select preset</x:String>
  <x:String x:Key="ClusterUnclusterToolTip">Group or ungroup servers</x:String>
  <x:String x:Key="RefreshToolTip">Refresh all server ping</x:String>
  <x:String x:Key="SwapGameModeUnblockAllConflict">This action will unblock all servers first to prevent firewall conflicts.</x:String>
  <x:String x:Key="LanguageComboBoxToolTip">Select language</x:String>
  <x:String x:Key="ResetFirewallToolTip">Delete every firewall rule this app created</x:String>
  <x:String x:Key="MessageBoxInfoTitle">Info</x:String>
  <x:String x:Key="SyncServersUnblockAllDialogue">Server data just got updated by Valve! All blocked servers will be unblocked in order to synchronize new server data. Preset entries for servers that no longer exist will be removed, and the last selected preset will be reapplied if available.</x:String>
  <x:String x:Key="NewVersionDialogue">New version available! Go to releases?</x:String>
  <x:String x:Key="SelectOneServerToBlockDialogue">Hey! Please select at least one server to block</x:String>
  <x:String x:Key="SelectOneServerToUnblockDialogue">Hey! Please select at least one server to unblock</x:String>
  <x:String x:Key="PendingOperationDialogue">Whoa! There's already a pending operation. Please wait...</x:String>
  <x:String x:Key="FirewallResetConfirmDialogue">This removes every firewall rule created by this app and unblocks all servers. Other firewall rules on your computer are not touched. Continue?</x:String>
  <x:String x:Key="FirewallResetSuccessDialogue">Removed {0} firewall rule(s) created by this app.</x:String>
  <x:String x:Key="Presets">Presets</x:String>
  <x:String x:Key="PresetsToolTip">Manage presets</x:String>
  <x:String x:Key="AddPreset">Add</x:String>
  <x:String x:Key="NewPresetName">New Preset</x:String>
  <x:String x:Key="AddPresetToolTip">Create a preset from your current selection</x:String>
  <x:String x:Key="DeletePreset">Delete</x:String>
  <x:String x:Key="DeletePresetToolTip">Delete selected presets</x:String>
  <x:String x:Key="ApplyPreset">Apply</x:String>
  <x:String x:Key="ApplyPresetToolTip">Apply the selected preset</x:String>
  <x:String x:Key="PresetsWindowTitle">Presets</x:String>
  <x:String x:Key="PresetServersHeader">Allowed Servers</x:String>
  <x:String x:Key="PresetListHeader">Preset</x:String>
  <x:String x:Key="PresetDeleteConfirmDialogue">Delete the preset '{0}'?</x:String>
  <x:String x:Key="PresetDeleteSelectedConfirmDialogue">Delete the {0} selected presets?</x:String>
  <x:String x:Key="PresetOverwriteConfirmDialogue">A preset named '{0}' already exists for this game. Overwrite it?</x:String>
  <x:String x:Key="PresetChangeViewModeConfirmDialogue">Changing between clustered and unclustered view will clear this preset's blocked entries. Continue?</x:String>
  <x:String x:Key="PresetNameRequiredDialogue">Preset name cannot be empty.</x:String>
  <x:String x:Key="LanguageLabel">Language</x:String>
  <x:String x:Key="ThemeLabel">Theme</x:String>
  <x:String x:Key="ThemeComboBoxToolTip">Select app theme</x:String>
  <x:String x:Key="ThemeSystem">System</x:String>
  <x:String x:Key="ThemeLight">Light</x:String>
  <x:String x:Key="ThemeDark">Dark</x:String>
  <x:String x:Key="SortLabel">Sort</x:String>
  <x:String x:Key="SortLocation">Location</x:String>
  <x:String x:Key="SortPing">Ping</x:String>
  <x:String x:Key="SortLoss">Loss</x:String>
  <x:String x:Key="StatusBlocked">blocked</x:String>
  <x:String x:Key="PingServerMenuItem">Ping this server</x:String>
  <x:String x:Key="NoServersMatch">No servers match your search</x:String>
  <x:String x:Key="BlockAllToolTip">Block every server shown</x:String>
  <x:String x:Key="UnblockAllToolTip">Remove all firewall rules</x:String>
  <x:String x:Key="AllowedColumnHeader">Allowed</x:String>
  <x:String x:Key="PresetAllowAll">All</x:String>
  <x:String x:Key="PresetAllowNone">None</x:String>
  <x:String x:Key="PresetAllowAllToolTip">Allow every server in this preset</x:String>
  <x:String x:Key="PresetAllowNoneToolTip">Block every server in this preset</x:String>
  <x:String x:Key="BlockSlowerMenuItem">Block servers this slow or worse</x:String>
  <x:String x:Key="AutoRefreshLabel">Auto refresh</x:String>
  <x:String x:Key="AutoRefreshToolTip">Re-ping unblocked servers on a timer</x:String>
  <x:String x:Key="AutoRefreshOff">Off</x:String>
  <x:String x:Key="AutoRefresh5">Every 5 minutes</x:String>
  <x:String x:Key="AutoRefresh15">Every 15 minutes</x:String>
  <x:String x:Key="AutoRefresh30">Every 30 minutes</x:String>
  <x:String x:Key="MinimizeToTrayLabel">Close to system tray</x:String>
  <x:String x:Key="MinimizeToTrayToolTip">Closing the window keeps the app running in the tray</x:String>
  <x:String x:Key="TrayShow">Show</x:String>
  <x:String x:Key="TrayQuit">Quit</x:String>
  <x:String x:Key="PresetShare">Share</x:String>
  <x:String x:Key="PresetShareToolTip">Copy a share code for the selected preset</x:String>
  <x:String x:Key="PresetImport">Import</x:String>
  <x:String x:Key="PresetImportToolTip">Add a preset from a share code on your clipboard</x:String>
  <x:String x:Key="PresetCodeCopiedDialogue">Share code copied to your clipboard.</x:String>
  <x:String x:Key="PresetImportedDialogue">Preset imported.</x:String>
  <x:String x:Key="PresetImportWrongGameDialogue">That code is for a different game. Switch games and try again.</x:String>
  <x:String x:Key="PresetImportInvalidDialogue">No valid share code found on your clipboard.</x:String>
  <x:String x:Key="BlockedOnExitDialogue">{0} servers are still blocked. Firewall rules stay in place after you close, so those servers remain blocked until you unblock them here.</x:String>
  <x:String x:Key="BlockedOnExitUnblock">Unblock all and close</x:String>
  <x:String x:Key="BlockedOnExitKeep">Close anyway</x:String>
  <x:String x:Key="BlockedOnExitCancel">Cancel</x:String>
  <x:String x:Key="RenderMode">Render Mode:</x:String>
  <x:String x:Key="RenderModeToolTip">Change how the app is rendered on the screen by using different graphics pipeline.</x:String>
  <x:String x:Key="RenderModeDialogue">Restart the application for the changes to take effect.</x:String>
  <x:String x:Key="AutoApplyOnGameLaunchLabel">Apply preset when the game starts</x:String>
  <x:String x:Key="AutoApplyOnGameLaunchToolTip">Applies this game's last used preset when the game launches, and unblocks everything again when it closes</x:String>
</ResourceDictionary>
