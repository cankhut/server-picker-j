  <x:String x:Key="NoServersMatch">Ningún servidor coincide con la búsqueda</x:String>
  <x:String x:Key="BlockAllToolTip">Bloquear todos los servidores mostrados</x:String>
  <x:String x:Key="UnblockAllToolTip">Eliminar todas las reglas del firewall</x:String>
  <x:String x:Key="AllowedColumnHeader">Permitido</x:String>
  <x:String x:Key="PresetAllowAll">Todos</x:String>
  <x:String x:Key="PresetAllowNone">Ninguno</x:String>
  <x:String x:Key="PresetAllowAllToolTip">Permitir todos los servidores de este preajuste</x:String>
  <x:String x:Key="PresetAllowNoneToolTip">Bloquear todos los servidores de este preajuste</x:String>
  <x:String x:Key="BlockSlowerMenuItem">Bloquear servidores con esta latencia o peor</x:String>
  <x:String x:Key="AutoRefreshLabel">Actualización automática</x:String>
  <x:String x:Key="AutoRefreshToolTip">Volver a medir los servidores no bloqueados cada cierto tiempo</x:String>
  <x:String x:Key="AutoRefreshOff">Desactivada</x:String>
  <x:String x:Key="AutoRefresh5">Cada 5 minutos</x:String>
  <x:String x:Key="AutoRefresh15">Cada 15 minutos</x:String>
  <x:String x:Key="AutoRefresh30">Cada 30 minutos</x:String>
  <x:String x:Key="MinimizeToTrayLabel">Cerrar a la bandeja del sistema</x:String>
  <x:String x:Key="MinimizeToTrayToolTip">Al cerrar la ventana la aplicación sigue en la bandeja</x:String>
  <x:String x:Key="TrayShow">Mostrar</x:String>
  <x:String x:Key="TrayQuit">Salir</x:String>
  <x:String x:Key="PresetShare">Compartir</x:String>
  <x:String x:Key="PresetShareToolTip">Copiar un código para el preajuste seleccionado</x:String>
  <x:String x:Key="PresetImport">Importar</x:String>
  <x:String x:Key="PresetImportToolTip">Añadir un preajuste desde un código en el portapapeles</x:String>
  <x:String x:Key="PresetCodeCopiedDialogue">Código copiado al portapapeles.</x:String>
  <x:String x:Key="PresetImportedDialogue">Preajuste importado.</x:String>
  <x:String x:Key="PresetImportWrongGameDialogue">Ese código es de otro juego. Cambia de juego e inténtalo de nuevo.</x:String>
  <x:String x:Key="PresetImportInvalidDialogue">No se encontró un código válido en el portapapeles.</x:String>
  <x:String x:Key="BlockedOnExitDialogue">{0} servidores siguen bloqueados. Las reglas del firewall permanecen tras cerrar, así que seguirán bloqueados hasta que los desbloquees aquí.</x:String>
  <x:String x:Key="BlockedOnExitUnblock">Desbloquear todo y cerrar</x:String>
  <x:String x:Key="BlockedOnExitKeep">Cerrar de todos modos</x:String>
  <x:String x:Key="BlockedOnExitCancel">Cancelar</x:String>
  <x:String x:Key="RenderMode">Modo de renderizado:</x:String>
  <x:String x:Key="RenderModeToolTip">Modifica la forma en que se renderiza la aplicación en pantalla mediante el uso de una canalización gráfica diferente.</x:String>
  <x:String x:Key="RenderModeDialogue">Reinicia la aplicación para que los cambios surtan efecto.</x:String>
